{
  "name": "tranquillity",
  "private": true,
  "workspaces": ["shared", "client"],
  "scripts": {
    "dev": "concurrently -n api,client -c cyan,magenta \"vercel dev --listen 3001\" \"npm run dev -w client\"",
    "dev:api": "vercel dev --listen 3001",
    "dev:client": "npm run dev -w client",
    "test": "npm test -w shared",
    "install:all": "npm install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vercel/node": "^3.2.0",
    "concurrently": "^8.2.2",
    "vercel": "^37.0.0"
  }
}
