# Supabase project credentials for the /api serverless functions.
# Same Supabase project as coinchapp — copy the real values from that
# project's dashboard (or from coinchapp's own .env.local).
# Copy this file to .env.local for `vercel dev` (do not commit .env.local).

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-only value used to act as the game authority (bypasses RLS).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
