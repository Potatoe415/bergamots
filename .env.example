# Server-only value used by api/yatsy/games/* to act as the Yatzy game
# authority. Never expose this to the browser. Set it as a Vercel project
# env var (Production + Preview), not in a committed file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared admin password for /admin. Also used as the HMAC key that signs the
# short-lived admin session tokens, so changing it invalidates active sessions.
# Use a long random value: it is the only thing protecting the stats page.
ADMIN_PASSWORD=a-long-random-string
